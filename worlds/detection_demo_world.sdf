<?xml version="1.0"?>
<sdf version="1.10">
  <world name="detection_demo_world">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.95 0.93 0.88 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.45 0.15 -0.88</direction>
    </light>

    <light type="point" name="softbox">
      <pose>3 -3 5 0 0 0</pose>
      <diffuse>0.45 0.48 0.55 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation>
        <range>20</range>
        <constant>0.7</constant>
        <linear>0.05</linear>
        <quadratic>0.002</quadratic>
      </attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>24 14</size></plane></geometry>
          <material>
            <ambient>0.52 0.52 0.50 1</ambient>
            <diffuse>0.66 0.66 0.62 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Demo trash route: all poses mirrored in config/trash_ground_truth.yaml. -->
    <include>
      <uri>model://cigarette_butt</uri>
      <name>demo_cigarette_butt_1</name>
      <pose>0.65 -0.45 0 0 0 0.20</pose>
    </include>
    <include>
      <uri>model://aluminum_can</uri>
      <name>demo_aluminum_can_1</name>
      <pose>2.70 -4.25 0 0 0 0.35</pose>
    </include>
    <include>
      <uri>model://plastic_bottle</uri>
      <name>demo_plastic_bottle_1</name>
      <pose>4.50 -0.45 0 0 0 -0.35</pose>
    </include>
    <include>
      <uri>model://cardboard_box</uri>
      <name>demo_cardboard_box_1</name>
      <pose>8.10 -0.45 0 0 0 0.55</pose>
    </include>
    <include>
      <uri>model://plastic_bag</uri>
      <name>demo_plastic_bag_1</name>
      <pose>6.30 -4.25 0 0 0 -0.25</pose>
    </include>
    <include>
      <uri>model://paper_packaging</uri>
      <name>demo_paper_packaging_1</name>
      <pose>9.90 -4.25 0 0 0 0.80</pose>
    </include>
  </world>
</sdf>
